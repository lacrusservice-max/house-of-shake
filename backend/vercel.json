{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/vigilar-externo",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/inactive-customers",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "0 9 * * *"
    }
  ]
}
